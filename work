SELF = os.path.realpath(__file__)
RUNTIME_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/work-{os.getuid()}", "work")
CONFIG_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                           "work", "config")

DEFAULT_CONFIG = r"""
