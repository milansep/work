def die(msg):
    sys.exit(f"work: {msg}")


def log(project, msg):
    """Debug log: $XDG_RUNTIME_DIR/work/<project>.log"""
    try:
        with open(os.path.join(RUNTIME_DIR, project + ".log"), "a") as f:
            f.write(time.strftime("%H:%M:%S ") + msg + "\n")
    except OSError:
        pass


# ------------------------------------------------------------------ config

def load_config():
    cp = configparser.ConfigParser(interpolation=None)
    cp.read_string(DEFAULT_CONFIG)
    cp.read(CONFIG_FILE)
    return cp


def parse_keys(spec):
    """Turn '^S' or '<C-\\><C-N>:w<CR>' into the characters a terminal sends."""
    names = {"cr": "\r", "enter": "\r", "esc": "\x1b", "tab": "\t", "space": " ", "lt": "<"}
    out, i = [], 0
    while i < len(spec):
        ch = spec[i]
        if ch == "^" and i + 1 < len(spec):
            # Ctrl+letter = the letter's code with bit 0x40 flipped (S=0x53 -> 0x13)
            out.append(chr(ord(spec[i + 1].upper()) ^ 0x40))
            i += 2
            continue
        if ch == "<":
            end = spec.find(">", i + 1)
            token = spec[i + 1:end].lower() if end != -1 else ""
            if token in names:
                out.append(names[token])
                i = end + 1
                continue
            if len(token) == 3 and token.startswith("c-"):
                out.append(chr(ord(token[2].upper()) ^ 0x40))
                i = end + 1
                continue
        out.append(ch)
        i += 1
    return "".join(out)


class EditorProfile:
    def __init__(self, cp):
        self.name = cp.get("work", "editor", fallback="nano")
        section = "editor." + self.name
        if not cp.has_section(section):
            die(f"no [{section}] section in {CONFIG_FILE}")
        s = cp[section]
        self.command = shlex.split(s.get("command", self.name + " {file}"))
        self.save = parse_keys(s.get("save", ""))
        self.quit = parse_keys(s.get("quit", ""))
        self.discard = parse_keys(s.get("discard", ""))
        self.dirty = s.get("dirty", "none")
        self.lockfile = s.get("lockfile", "{dir}/.{name}.swp")

    def argv(self, path):
        if not any("{file}" in arg for arg in self.command):
            return self.command + [path]
        return [arg.replace("{file}", path) for arg in self.command]

    def lockfile_for(self, path):
        folder, name = os.path.split(path)
        result = self.lockfile
        for key, value in (("{dir}", folder), ("{name}", name),
                           ("{path%}", path.replace("/", "%")), ("{path}", path)):
            result = result.replace(key, value)
        return os.path.expanduser(result)

    def is_dirty(self, path):
        """vim swap files (and nano's --locking files, which copy their format)
        keep a 'modified' byte at offset 1007. nano sets it but never clears it
        after saving, so we also require the lock file to be newer than the file:
        nano rewrites the lock file on the first change after every save."""
        if self.dirty != "lockfile":
            return False
        try:
            with open(self.lockfile_for(path), "rb") as f:
                f.seek(1007)
                flag = f.read(1)
                lock_mtime = os.fstat(f.fileno()).st_mtime_ns
        except OSError:
            return False
        try:
            file_mtime = os.stat(path).st_mtime_ns
        except OSError:
            file_mtime = 0
        return flag == b"U" and lock_mtime > file_mtime


# --------------------------------------------------------------- sway IPC

class Sway:
    """Minimal client for sway's IPC socket (the protocol swaymsg speaks):
    every message is 'i3-ipc' + payload length + message type + JSON payload."""
    RUN_COMMAND, GET_WORKSPACES, SUBSCRIBE, GET_TREE = 0, 1, 2, 4

    def __init__(self):
        path = os.environ.get("SWAYSOCK")
        if not path:
            die("SWAYSOCK is not set. Is sway running?")
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)

    def _read(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("sway closed the IPC socket")
            buf += chunk
        return buf

    def receive(self):
        length, kind = struct.unpack("=II", self._read(14)[6:])
        return kind, json.loads(self._read(length))

    def request(self, kind, payload=""):
        data = payload.encode()
        self.sock.sendall(b"i3-ipc" + struct.pack("=II", len(data), kind) + data)
        return self.receive()[1]

    def command(self, cmd):
        return self.request(self.RUN_COMMAND, cmd)

    def tree(self):
        return self.request(self.GET_TREE)

    def workspaces(self):
        return self.request(self.GET_WORKSPACES)

    def subscribe(self, events):
        return self.request(self.SUBSCRIBE, json.dumps(events))


def walk(node, parent=None, workspace=None):
    """Yield (node, parent, workspace) for every container in a sway tree."""
    if node.get("type") == "workspace":
        workspace = node
    yield node, parent, workspace
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        yield from walk(child, node, workspace)


def quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


# ---------------------------------------------- sessions, sockets, spawning

def project_id(root):
    return hashlib.sha1(root.encode()).hexdigest()[:10]


def socket_path(project):
    return os.path.join(RUNTIME_DIR, project + ".sock")


def coordinator_app_id(project):
    return "work-" + project


def editor_app_id(project):
    return f"work-{project}-{secrets.token_hex(3)}"


def send_line(sock, msg):
    sock.sendall((json.dumps(msg) + "\n").encode())


def request(path, msg, timeout=2.0):
    """Send one message to a coordinator and return its reply (None if nobody answers)."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(path)
            send_line(s, msg)
            data = b""
            while not data.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                data += chunk
            return json.loads(data) if data else None
    except (OSError, ValueError):
        return None


def spawn(argv, cwd):
    """Start a program detached from us (own session, no shared terminal)."""
    env = dict(os.environ)
    # these tell sway which workspace a new window belongs to; don't pass ours on
    env.pop("XDG_ACTIVATION_TOKEN", None)
    env.pop("DESKTOP_STARTUP_ID", None)
    return subprocess.Popen(argv, cwd=cwd, env=env, start_new_session=True,
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)


# ---------------------------------------------------------------- launcher

def launch(target):
    path = os.path.realpath(target)
    if os.path.isfile(path):
        # is there a session for this file's folder or one of its parents?
        folder = os.path.dirname(path)
        while True:
            reply = request(socket_path(project_id(folder)), {"cmd": "open", "path": path})
            if reply and reply.get("ok"):
                return
            if os.path.dirname(folder) == folder:
                break
            folder = os.path.dirname(folder)
        start(os.path.dirname(path), path)
    elif os.path.isdir(path):
        start(path)
    else:
        die(f"{target}: no such file or folder")


def start(root, open_file=None):
    project = project_id(root)
    app_id = coordinator_app_id(project)
    sway = Sway()
    if request(socket_path(project), {"cmd": "ping"}):
        # already open: just jump there
        sway.command(f'[app_id="^{app_id}$"] focus')
        return

    used = {ws["num"] for ws in sway.workspaces()}
    number = next(n for n in range(1, 1000) if n not in used)
    label = re.sub(r"[^\w.-]+", "_", os.path.basename(root)) or "root"
    workspace = f"{number}:{label}"
    sway.command(f"workspace {quote(workspace)}")

    argv = ["foot", "--app-id", app_id, "--title", f"work: {label}",
            sys.executable, SELF, "--coordinator", root]
    if open_file:
        argv += ["--open", open_file]
    try:
        spawn(argv, root)
    except FileNotFoundError:
        die("foot is not installed")

    # make sure the window lands on the new workspace, even if focus moved meanwhile
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        for node, _, ws in walk(sway.tree()):
            if node.get("app_id") == app_id:
                if ws and ws["name"] != workspace:
                    sway.command(f"[con_id={node['id']}] move container to workspace {quote(workspace)}; "
                                 f"workspace {quote(workspace)}")
                return
        time.sleep(0.1)


# ------------------------------------------------------------ editor proxy
#
# Every editor runs as:  foot -> work --edit (this proxy) -> nano
# The proxy owns a pseudo-terminal (pty) for the editor and copies bytes both
# ways, so to you it feels like plain nano. It also stays connected to the
# coordinator, which can "type" into the editor (^S to save, ^X to quit) and
# set the window title shown on the tab.

def write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def edit_main(sock_path, app_id, path, argv):
    try:
        size = fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8)
    except OSError:
        size = None

    pid, master = pty.fork()
    if pid == 0:  # child: becomes the editor
        if size:
            fcntl.ioctl(0, termios.TIOCSWINSZ, size)
        try:
            os.execvp(argv[0], argv)
        except OSError as e:
            print(f"work: cannot run {argv[0]}: {e.strerror}")
            os._exit(127)

    def on_resize(*_):
        try:
            fcntl.ioctl(master, termios.TIOCSWINSZ, fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8))
        except OSError:
            pass
    signal.signal(signal.SIGWINCH, on_resize)

    saved_tty = termios.tcgetattr(0)
    tty.setraw(0)  # pass every key (Ctrl+C, Ctrl+S...) straight through
    try:
        proxy_loop(sock_path, app_id, path, master)
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, saved_tty)

    os.close(master)
    code = os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1])
    if code != 0:
        try:
            input(f"\nwork: the editor exited with status {code}. Press Enter to close.")
        except (EOFError, OSError):
            pass
    sys.exit(max(code, 0))


def proxy_loop(sock_path, app_id, path, master):
    conn, inbox, next_try, title = None, b"", 0.0, None
    while True:
        # (re)connect to the coordinator; if it restarts, editors re-register
        if conn is None and time.monotonic() >= next_try:
            next_try = time.monotonic() + 2
            try:
                conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                conn.connect(sock_path)
                send_line(conn, {"cmd": "hello", "app_id": app_id, "path": path, "pid": os.getpid()})
            except OSError:
                conn.close()
                conn = None

        watch = [0, master] + ([conn] if conn else [])
        ready, _, _ = select.select(watch, [], [], 0.05 if title else 1.0)

        if master in ready:  # editor -> screen
            try:
                data = os.read(master, 65536)
            except OSError:  # EIO: the editor exited
                data = b""
            if not data:
                return
            write_all(1, data)

        if 0 in ready:  # keyboard -> editor
            data = os.read(0, 65536)
            if not data:
                return
            try:
                write_all(master, data)
            except OSError:
                return

        if conn is not None and conn in ready:  # coordinator -> us
            try:
                chunk = conn.recv(65536)
            except OSError:
                chunk = b""
            if not chunk:
                conn.close()
                conn, inbox = None, b""
            inbox += chunk
            while b"\n" in inbox:
                line, inbox = inbox.split(b"\n", 1)
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if msg.get("cmd") == "keys":
                    try:
                        write_all(master, msg["keys"].encode())
                    except OSError:
                        pass
                elif msg.get("cmd") == "title":
                    title = "".join(c for c in msg["title"] if c.isprintable())

        # set the window title (OSC 2) only while the editor is quiet, so we
        # never land in the middle of one of its own escape sequences
        if title is not None and master not in ready:
            write_all(1, f"\x1b]2;{title}\x1b\\".encode())
            title = None


# ------------------------------------------------------------- coordinator

class Row:
    __slots__ = ("path", "name", "depth", "is_dir")

    def __init__(self, path, name, depth, is_dir):
        self.path, self.name, self.depth, self.is_dir = path, name, depth, is_dir


class Tab:
    """One open editor window."""

    def __init__(self, app_id, path):
        self.app_id = app_id
        self.path = path
        self.proc = None        # the foot process, if we started it
        self.conn = None        # socket to its proxy, once it has said hello
        self.con_id = None      # sway container id, once its window appeared
        self.placed = False
        self.dirty = False
        self.title_sent = None

    def send(self, msg):
        if self.conn is None:
            return False
        try:
            send_line(self.conn, msg)
            return True
        except OSError:
            return False

    def keys(self, keys):
        return self.send({"cmd": "keys", "keys": keys})


class Client:
    def __init__(self):
        self.buf = b""
        self.tab = None


class Quit(Exception):
    pass


HELP = """\
